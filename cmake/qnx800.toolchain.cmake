# QNX SDP 8.0 toolchain file. Usage: -DCMAKE_TOOLCHAIN_FILE=cmake/qnx800.toolchain.cmake -DQNX_ARCH=aarch64le|x86_64
# Requires: source ~/qnx800/qnxsdp-env.sh (sets QNX_HOST, QNX_TARGET). UNTESTED until the SDP is installed.
set(CMAKE_SYSTEM_NAME QNX)
if(NOT QNX_ARCH)
  set(QNX_ARCH aarch64le)
endif()
set(CMAKE_SYSTEM_PROCESSOR ${QNX_ARCH})
set(QNX_HOST "$ENV{QNX_HOST}")
set(QNX_TARGET "$ENV{QNX_TARGET}")
if(NOT QNX_HOST OR NOT QNX_TARGET)
  message(FATAL_ERROR "QNX_HOST/QNX_TARGET unset: source ~/qnx800/qnxsdp-env.sh first")
endif()
set(CMAKE_C_COMPILER   ${QNX_HOST}/usr/bin/qcc)
set(CMAKE_CXX_COMPILER ${QNX_HOST}/usr/bin/q++)
if(QNX_ARCH STREQUAL "aarch64le")
  set(_V gcc_ntoaarch64le)
else()
  set(_V gcc_ntox86_64)
endif()
set(CMAKE_C_COMPILER_TARGET   ${_V})
set(CMAKE_CXX_COMPILER_TARGET ${_V}_cxx)
set(CMAKE_C_FLAGS_INIT   "-V${_V}")
set(CMAKE_CXX_FLAGS_INIT "-V${_V}_cxx -std=gnu++17")
set(CMAKE_FIND_ROOT_PATH ${QNX_TARGET} ${QNX_TARGET}/${QNX_ARCH}/usr)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
